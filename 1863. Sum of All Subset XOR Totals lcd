class Solution {
    public int subsetXORSum(int[] nums) {
        int result = 0;

        for(int i = 0; i < (1 << nums.length); i++) {
            int minixor = 0;

            for(int j = 0; j < nums.length; j++) {
                if((i & (1 << j)) != 0) {
                    minixor = minixor ^ nums[j];
                }
            }

            result = result + minixor;
        }

        return result;
    }
}
