class Solution {
    public int mostFrequentEven(int[] nums) {
        HashMap<Integer, Integer> hm = new HashMap<>();
        for (int num : nums) {
            if (num % 2 == 0) {
                hm.put(num, hm.getOrDefault(num, 0) + 1);
            }
        }
        int ans = -1, max = 0;
        for (int num : hm.keySet()) {
            if (hm.get(num) > max ||
               (hm.get(num) == max && num < ans)) {
                max = hm.get(num);
                ans = num;
            }
        }
        return ans;
    }
}
