class Solution {
    public int maxLength(int[] nums) {
        int maxVal = 0, maxLcm = 1;
        for (int x : nums) {
            maxVal = Math.max(maxVal, x);
            maxLcm = lcm(maxLcm, x);
        }
        int maxP = maxLcm * maxVal;
        
        int n = nums.length;
        int ans = 0;
        
        for (int i = 0; i < n; ++i) {
            int prod = 1, currLcm = 1, currGcd = 0;
            for (int j = i; j < n; ++j) {
                prod *= nums[j];
                if (prod > maxP) break;
                
                currLcm = lcm(currLcm, nums[j]);
                currGcd = gcd(currGcd, nums[j]);
                
                if (prod == currLcm * currGcd) {
                    ans = Math.max(ans, j - i + 1);
                }
            }
        }
        return ans;
    }
    
    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
    
    private int lcm(int a, int b) {
        return a / gcd(a, b) * b;
    }
}
