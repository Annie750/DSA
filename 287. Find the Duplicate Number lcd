class Solution {
    public static int findDuplicate(int[] arr) {

    int slow = arr[0];
    int fast = arr[0];

    // Phase 1: Find intersection point
    do {
        slow = arr[slow];
        fast = arr[arr[fast]];
    } while (slow != fast);

    // Phase 2: Find entrance of cycle
    slow = arr[0];

    while (slow != fast) {
        slow = arr[slow];
        fast = arr[fast];
    }

    return slow;
}}
